generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
  VIEWER
  WORKSPACE_OWNER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApiKeyPermission {
  READ
  WRITE
  ADMIN
}

enum AgentStatus {
  DRAFT
  TRAINING
  ACTIVE
  INACTIVE
  DEPLOYING
}

enum LlmModel {
  GPT_4O
  GPT_4O_MINI
  CLAUDE_3_5_SONNET
  CLAUDE_3_HAIKU
  GEMINI_1_5_PRO
  LLAMA_3_1_70B
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  AZURE_OPENAI
  OPENROUTER
  OLLAMA
}

enum FileType {
  PDF
  DOCX
  TXT
  CSV
  JSON
  MARKDOWN
  URL
}

enum FileStatus {
  INDEXED
  PROCESSING
  FAILED
  PENDING
}

enum TrainingStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DeploymentEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum DeploymentStatus {
  ACTIVE
  INACTIVE
  FAILED
  ROLLED_BACK
}

enum WidgetTheme {
  LIGHT
  DARK
  SYSTEM
}

enum WidgetLauncherPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum BillingPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum NotificationType {
  SYSTEM
  AGENT
  WORKSPACE
  BILLING
  TRAINING
  DEPLOYMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String
  name                    String
  avatarUrl               String?
  role                    Role                    @default(DEVELOPER)
  isVerified              Boolean                 @default(false)
  twoFactorEnabled        Boolean                 @default(false)
  twoFactorSecret         String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  refreshTokens           RefreshToken[]
  sessions                Session[]
  memberships             WorkspaceMember[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  createdApiKeys          ApiKey[]
  createdAgents           Agent[]
  createdAgentVersions    AgentVersion[]
  createdKnowledgeFiles   KnowledgeFile[]
  createdDatasets         TrainingDataset[]
  createdTrainingJobs     TrainingJob[]
  createdPromptTemplates  PromptTemplate[]
  promptExecutions        PromptExecution[]
  providerConfigs         LlmProviderConfig[]
  ragLogs                 RagQueryLog[]
  createdSessions         ConversationSession[]
  createdChatMessages     ChatMessage[]
  deployedDeployments     AgentDeployment[]
  billingAccounts         BillingAccount[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model Workspace {
  id              String                @id @default(uuid())
  name            String
  slug            String                @unique
  logoUrl         String?
  branding        Json?
  ipWhitelist     String[]              @default([])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  apiKeys         ApiKey[]
  agents          Agent[]
  knowledgeFiles  KnowledgeFile[]
  datasets        TrainingDataset[]
  trainingJobs    TrainingJob[]
  promptTemplates PromptTemplate[]
  promptExecutions PromptExecution[]
  providerConfigs LlmProviderConfig[]
  ragLogs         RagQueryLog[]
  chatSessions    ConversationSession[]
  chatMessages    ChatMessage[]
  auditLogs       AuditLog[]
  deployments     AgentDeployment[]
  widgetConfigs   ChatWidgetConfig[]
  billingAccount  BillingAccount?
  invoices        Invoice[]
  usageRecords    UsageRecord[]
  notifications   Notification[]

  @@map("workspaces")
}

model LlmProviderConfig {
  id              String       @id @default(uuid())
  provider        ProviderType
  apiKeyMasked    String?
  apiKeyEncrypted String?
  baseUrl         String?
  isDefault       Boolean      @default(false)
  isEnabled       Boolean      @default(true)
  priority        Int          @default(1)
  workspaceId     String
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("llm_provider_configs")
}

model Agent {
  id               String                @id @default(uuid())
  name             String
  description      String
  category         String                @default("General")
  tags             String[]              @default([])
  status           AgentStatus           @default(DRAFT)
  currentVersion   String                @default("1.0.0")
  model            LlmModel              @default(GPT_4O)
  temperature      Float                 @default(0.7)
  maxTokens        Int                   @default(4096)
  systemPrompt     String                @default("You are a helpful AI assistant.")
  avatarColor      String                @default("#3B82F6")
  totalChats       Int                   @default(0)
  lastTrainingAt   DateTime?
  workspaceId      String
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  versions         AgentVersion[]
  trainingJobs     TrainingJob[]
  datasets         TrainingDataset[]
  promptExecutions PromptExecution[]
  ragLogs          RagQueryLog[]
  chatSessions     ConversationSession[]
  deployments      AgentDeployment[]
  widgetConfig     ChatWidgetConfig?

  @@map("agents")
}

model AgentVersion {
  id            String   @id @default(uuid())
  agentId       String
  versionNumber String
  systemPrompt  String
  model         LlmModel
  temperature   Float
  maxTokens     Int
  changelog     String?
  createdById   String
  createdAt     DateTime @default(now())
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("agent_versions")
}

model KnowledgeFile {
  id           String          @id @default(uuid())
  name         String
  type         FileType        @default(TXT)
  sizeBytes    BigInt          @default(0)
  mimeType     String?
  filePath     String?
  url          String?
  status       FileStatus      @default(PENDING)
  chunksCount  Int             @default(0)
  errorMessage String?
  workspaceId  String
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@map("knowledge_files")
}

model DocumentChunk {
  id              String        @id @default(uuid())
  knowledgeFileId String
  chunkIndex      Int
  content         String
  tokenCount      Int           @default(0)
  embedding       Unsupported("vector(768)")?
  metadata        Json?
  createdAt       DateTime      @default(now())
  knowledgeFile   KnowledgeFile @relation(fields: [knowledgeFileId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model ConversationSession {
  id          String        @id @default(uuid())
  agentId     String
  title       String        @default("New Conversation")
  metadata    Json?
  workspaceId String
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@map("conversation_sessions")
}

model ChatMessage {
  id          String              @id @default(uuid())
  sessionId   String
  role        ChatRole
  content     String
  tokensCount Int                 @default(0)
  latencyMs   Int                 @default(0)
  citations   Json?
  workspaceId String
  createdById String
  createdAt   DateTime            @default(now())
  session     ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model RagQueryLog {
  id                   String    @id @default(uuid())
  agentId              String?
  queryText            String
  retrievedChunksCount Int       @default(0)
  topScore             Float     @default(0.0)
  contextTokens        Int       @default(0)
  citations            Json?
  latencyMs            Int       @default(0)
  workspaceId          String
  createdById          String
  createdAt            DateTime  @default(now())
  agent                Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("rag_query_logs")
}

model TrainingDataset {
  id            String        @id @default(uuid())
  name          String
  description   String?
  version       String        @default("v1.0")
  sampleCount   Int           @default(0)
  fileSizeBytes BigInt        @default(0)
  filePath      String?
  agentId       String?
  workspaceId   String
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  agent         Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  trainingJobs  TrainingJob[]

  @@map("training_datasets")
}

model TrainingJob {
  id              String          @id @default(uuid())
  jobName         String
  agentId         String
  datasetId       String?
  status          TrainingStatus  @default(QUEUED)
  epochs          Int             @default(3)
  learningRate    Float           @default(0.0001)
  batchSize       Int             @default(8)
  currentEpoch    Int             @default(0)
  totalEpochs     Int             @default(3)
  progressPercent Float           @default(0.0)
  currentLoss     Float           @default(1.0)
  trainingLogs    String[]        @default([])
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  workspaceId     String
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dataset         TrainingDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("training_jobs")
}

model PromptTemplate {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  category           String            @default("General")
  systemPrompt       String            @default("You are a helpful assistant.")
  userPromptTemplate String
  variables          String[]          @default([])
  model              LlmModel          @default(GPT_4O)
  temperature        Float             @default(0.7)
  maxTokens          Int               @default(4096)
  isPublic           Boolean           @default(false)
  workspaceId        String
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  executions         PromptExecution[]

  @@map("prompt_templates")
}

model PromptExecution {
  id            String          @id @default(uuid())
  templateId    String?
  agentId       String?
  systemPrompt  String
  userPrompt    String
  variablesUsed Json?
  model         LlmModel
  outputContent String
  latencyMs     Int             @default(0)
  tokensUsed    Int             @default(0)
  workspaceId   String
  createdById   String
  createdAt     DateTime        @default(now())
  template      PromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  agent         Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User            @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("prompt_executions")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  status      InviteStatus  @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}

model ApiKey {
  id          String             @id @default(uuid())
  name        String
  keyPrefix   String
  keyHash     String             @unique
  workspaceId String
  createdById String
  permissions ApiKeyPermission[] @default([READ])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model AuditLog {
  id          String     @id @default(uuid())
  userId      String?
  workspaceId String?
  action      String
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  message   String
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("system_logs")
}

model AgentDeployment {
  id            String                @id @default(uuid())
  agentId       String
  workspaceId   String
  environment   DeploymentEnvironment @default(PRODUCTION)
  status        DeploymentStatus      @default(ACTIVE)
  versionNumber String                @default("1.0.0")
  url           String?
  domain        String?
  deployedById  String
  deployedAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  agent         Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deployedBy    User                  @relation(fields: [deployedById], references: [id], onDelete: Cascade)

  @@map("agent_deployments")
}

model ChatWidgetConfig {
  id               String               @id @default(uuid())
  agentId          String               @unique
  workspaceId      String
  title            String               @default("Chat with our assistant")
  welcomeMessage   String               @default("Hi there! How can I help you today?")
  theme            WidgetTheme          @default(LIGHT)
  primaryColor     String               @default("#3B82F6")
  launcherPosition WidgetLauncherPosition @default(BOTTOM_RIGHT)
  launcherSize     Int                  @default(56)
  showAvatar       Boolean              @default(true)
  avatarUrl        String?
  allowFileUpload  Boolean              @default(false)
  enableRag        Boolean              @default(true)
  prePrompt        String?
  suggestedQuestions String[]          @default([])
  isPublished      Boolean              @default(false)
  widgetToken      String               @unique
  customDomain     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  agent            Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("chat_widget_configs")
}

model BillingAccount {
  id                   String       @id @default(uuid())
  workspaceId          String       @unique
  plan                 BillingPlan  @default(FREE)
  status               BillingStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  seats                Int          @default(1)
  monthlyTokenQuota    BigInt       @default(1000000)
  totalTokensUsed      BigInt       @default(0)
  totalSpendUsd        Decimal      @default(0) @db.Decimal(12, 2)
  cancelAtPeriodEnd    Boolean      @default(false)
  createdById          String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  invoices             Invoice[]
  usageRecords         UsageRecord[]

  @@map("billing_accounts")
}

model Invoice {
  id              String        @id @default(uuid())
  workspaceId     String
  accountId       String?
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(OPEN)
  amountUsd       Decimal       @db.Decimal(12, 2)
  currency        String        @default("usd")
  description     String?
  stripeInvoiceId String?
  periodStart     DateTime?
  periodEnd       DateTime?
  issuedAt        DateTime      @default(now())
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  account         BillingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model UsageRecord {
  id          String        @id @default(uuid())
  workspaceId String
  accountId   String?
  model       LlmModel
  tokensUsed  Int           @default(0)
  costUsd     Decimal       @default(0) @db.Decimal(12, 6)
  recordedAt  DateTime      @default(now())
  account     BillingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model Notification {
  id          String             @id @default(uuid())
  userId      String
  workspaceId String?
  type        NotificationType   @default(SYSTEM)
  title       String
  body        String?
  icon        String?
  link        String?
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String             @id @default(uuid())
  userId  String
  type    NotificationType   @default(SYSTEM)
  channel NotificationChannel @default(IN_APP)
  enabled Boolean            @default(true)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}
